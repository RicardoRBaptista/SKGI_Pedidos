@page "/sqlserver"
@using SKGI_Pedidos.Models
@inject HttpClient Http

<PageTitle>Pedido</PageTitle>

<h1>Pedido</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (lPedidos == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Pedido</th>
                <th>Emissao</th>
                <th>Transportadora</th>
                <th>Coleta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Pedidos pedido in lPedidos)
            {
                <tr>
                    <td>@pedido.Pedido</td>
                    <td>@pedido.Emissao</td>
                    <td>@pedido.Transportadora</td>
                    <td>@pedido.date</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Pedidos[]? lPedidos;

    protected override async Task OnInitializedAsync()
    {
        lPedidos = await Http.GetFromJsonAsync<Pedidos[]>("sample-data/weather.json");
    }
}
