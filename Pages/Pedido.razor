@page "/pedidos"

<h3>Lista de Pedidos</h3>

<table class="table">
    <thead>
        <tr>
            <th>Número</th>
            <th>Emissão</th>
            <th>Status</th>
            <th>Qtd Total</th>
            <th>NF</th>
            <th>Coleta</th>
            <th>Cliente</th>
            <th>Transportadora</th>
            <th>OBS</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in pedidos)
        {
            <tr>
                <td>@pedido.Numero</td>
                <td>@pedido.Emissao.ToString("dd/MM/yyyy")</td>
                <td>@pedido.Status</td>
                <td>@pedido.QtdTotal</td>
                <td>@pedido.NF</td>
                <td>@pedido.Coleta.ToString("dd/MM/yyyy")</td>
                <td>@pedido.Cliente</td>
                <td>@pedido.Transportadora</td>
                <td>@pedido.OBS</td>
            </tr>
        }
    </tbody>
</table>

