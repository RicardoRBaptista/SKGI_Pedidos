@page "/EstoqueProdutos"

<h3>Estoque de Produtos</h3>

@if (estoques == null)
{
    <p><em>Loading...</em></p>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Saldo de Estoque</th>
            <th>Empenhada</th>
            <th>Quarentena</th>
            <th>Não Conforme</th>
            <th>Estoque</th>
        </tr>
    </thead>
    <tbody>
            @foreach (Estoque estoque in estoques)
        {
            <tr>
                <td>@estoque.Codigo</td>
                <td>@estoque.Nome</td>
                <td>@estoque.SaldoEstoque</td>
                <td>@estoque.Empenhada</td>
                <td>@estoque.Quarentena</td>
                <td>@estoque.NaoConforme</td>
                <td>@estoque.EstoqueFinal</td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    private List<Estoque> estoques = Estoque.carregaEstoque();
}
