@page "/EstoqueProdutos"

<h3>Estoque de Produtos</h3>

@if (lEstoque == null)
{
    <p><em>Loading...</em></p>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Saldo de Estoque</th>
            <th>Empenhada</th>
            <th>Quarentena</th>
            <th>Não Conforme</th>
            <th>Estoque</th>
        </tr>
    </thead>
    <tbody>
            @foreach (Estoque estoque in lEstoque)
        {
            <tr>
                <td>@estoque.codigo</td>
                <td>@estoque.Nome</td>
                <td>@estoque.SaldoEstoque</td>
                <td>@estoque.Empenhada</td>
                <td>@estoque.Quarentena</td>
                <td>@estoque.NaoConforme</td>
                <td>@estoque.EstoqueFinal</td>
            </tr>
        }
    </tbody>
</table>
}

